{
  "description": "Deterministic AUTO orchestration state, validation, and provenance hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/90_工具与配置/scripts/lifecycle_hooks.py\"",
            "commandWindows": "\".venv\\Scripts\\python.exe\" \"90_工具与配置\\scripts\\lifecycle_hooks.py\"",
            "timeout": 30,
            "statusMessage": "Validating AUTO project state",
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/90_工具与配置/scripts/lifecycle_hooks.py\"",
            "commandWindows": "\".venv\\Scripts\\python.exe\" \"90_工具与配置\\scripts\\lifecycle_hooks.py\"",
            "timeout": 10,
            "statusMessage": "Recording subagent metadata"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/90_工具与配置/scripts/lifecycle_hooks.py\"",
            "commandWindows": "\".venv\\Scripts\\python.exe\" \"90_工具与配置\\scripts\\lifecycle_hooks.py\"",
            "timeout": 10,
            "statusMessage": "Completing subagent metadata"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/90_工具与配置/scripts/lifecycle_hooks.py\"",
            "commandWindows": "\".venv\\Scripts\\python.exe\" \"90_工具与配置\\scripts\\lifecycle_hooks.py\"",
            "timeout": 150,
            "statusMessage": "Validating changed artifacts and provenance"
          }
        ]
      }
    ]
  }
}
