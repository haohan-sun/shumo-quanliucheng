{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "results.schema.json",
  "title": "Formal Result Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "results"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"type": "string"},
    "generated_at": {"type": ["string", "null"], "format": "date-time"},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result_id", "experiment_id", "run_id", "claim", "value", "unit", "artifact_path", "artifact_sha256", "verification_status"],
        "properties": {
          "result_id": {"type": "string"},
          "experiment_id": {"type": "string"},
          "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"},
          "claim": {"type": "string"},
          "value": {},
          "unit": {"type": ["string", "null"]},
          "artifact_path": {"type": "string"},
          "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "verification_status": {"enum": ["unverified", "verified", "rejected"]}
        }
      }
    }
  }
}
