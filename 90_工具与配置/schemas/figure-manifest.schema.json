{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "figure-manifest.schema.json",
  "title": "Figure Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "figures"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"type": "string"},
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["figure_id", "run_id", "claim", "data_source", "result_source", "script", "figure_contract", "reference_bundle", "output_png", "output_svg", "output_pdf", "verification_status"],
        "properties": {
          "figure_id": {"type": "string"},
          "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"},
          "claim": {"type": "string"},
          "data_source": {"type": ["string", "null"]},
          "result_source": {"type": ["string", "null"]},
          "script": {"type": "string"},
          "figure_contract": {"type": "string"},
          "reference_bundle": {"type": ["string", "null"]},
          "output_png": {"type": "string"},
          "output_svg": {"type": ["string", "null"]},
          "output_pdf": {"type": ["string", "null"]},
          "verification_status": {"enum": ["unverified", "verified", "rejected"]}
        }
      }
    }
  }
}
